// Schema LOCAL (SQLite) — dev uniquement.
// Vercel remplace ce fichier par schema.postgresql.prisma au moment du build (voir vercel.json).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id             String   @id @default(cuid())
  title          String
  title_en       String?
  description    String
  description_en String?
  date           DateTime
  time           String
  location       String?
  coverImage     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String?
  content     String
  content_en  String?
  rating      Int      @default(5)
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  title_en    String?
  content     String
  content_en  String?
  isUrgent    Boolean  @default(false)
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  leader      String?
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Sermon {
  id             String   @id @default(cuid())
  title          String
  title_en       String?
  preacher       String
  date           DateTime
  verses         String?
  verses_en      String?
  description    String?
  description_en String?
  videoUrl       String?
  audioUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
